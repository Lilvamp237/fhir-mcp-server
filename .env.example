# Details about the FHIR MCP Server
FHIR_MCP_HOST="localhost"
FHIR_MCP_PORT="8000"

# (Optional) If set, this value will be used as the server's base URL instead of generating it from host and port
# FHIR_MCP_SERVER_URL=""

# (Optional) Timeout from MCP server to FHIR server, in seconds
# FHIR_MCP_REQUEST_TIMEOUT=30

# (Optional) Host and Origin values accepted when the server is reached by a name other than localhost
# FHIR_MCP_ALLOWED_HOSTS="mcp.example.com"
# FHIR_MCP_ALLOWED_ORIGINS="https://app.example.com"

# MCP authorization: clients sign in with your identity provider (IdP); the server validates their tokens.
# Set FHIR_MCP_AUTH_MODE="disabled" only for local development without sign-in.
# FHIR_MCP_AUTH_MODE="resource_server"
FHIR_MCP_IDP_ISSUER=""
# (Optional) CA certificate for an IdP with a self-signed certificate, e.g. a local ThunderID
# FHIR_MCP_IDP_CA_CERT="./thunderid.cert"
# (Optional) Defaults to FHIR_MCP_SERVER_URL (or http://host:port) followed by /mcp; tokens must carry it as `aud`
# FHIR_MCP_RESOURCE_URL="http://localhost:8000/mcp"
# (Optional) "jwks" (default) or "introspection"
# FHIR_MCP_TOKEN_VALIDATION="jwks"
# FHIR_MCP_INTROSPECTION_CLIENT_ID=""
# FHIR_MCP_INTROSPECTION_CLIENT_SECRET=""
# (Optional) Scopes required by the read, write and delete tools
# FHIR_MCP_READ_SCOPE="fhir-read"
# FHIR_MCP_WRITE_SCOPE="fhir-write"
# FHIR_MCP_DELETE_SCOPE="fhir-delete"

# Details about the FHIR server/API
FHIR_SERVER_BASE_URL=""
# (Optional) How the MCP server authenticates to the FHIR server: "none" or "static_token".
# Defaults to "static_token" when FHIR_SERVER_ACCESS_TOKEN is set, otherwise "none".
# FHIR_SERVER_AUTH_MODE="none"
# FHIR_SERVER_ACCESS_TOKEN=""

# Database for the Docker Compose stack (docker-compose.yml)
DB_USER="postgres"
DB_PASSWORD=''
DB_NAME="postgres"
