# =====================================================================
# MCP server
# =====================================================================
FHIR_MCP_HOST="localhost"
FHIR_MCP_PORT="8000"
# (Optional) Public base URL of the server; defaults to http://<host>:<port>
# FHIR_MCP_SERVER_URL=""
# (Optional) Timeout for calls from the MCP server to the FHIR server, in seconds
# FHIR_MCP_REQUEST_TIMEOUT=30
# (Optional) Host and Origin values accepted when the server is reached by a name other than localhost
# FHIR_MCP_ALLOWED_HOSTS="mcp.example.com"
# FHIR_MCP_ALLOWED_ORIGINS="https://app.example.com"
# (Optional) Maximum request body size in bytes; the SDK default is 4 MiB
# FHIR_MCP_MAX_REQUEST_BODY_BYTES=4194304

# =====================================================================
# MCP login: who may use the MCP server
# Agents (for example a Claude Code instance) get their own token from your identity provider
# (IdP) with client credentials; the server only validates it. See README, Linking agents.
# =====================================================================
# "resource_server" (default), or "disabled" for local development without sign-in
# FHIR_MCP_AUTH_MODE="resource_server"
# The IdP's issuer, exactly as in its tokens' `iss` claim, e.g. a local ThunderID
FHIR_MCP_IDP_ISSUER="https://localhost:8090"
# (Optional) CA certificate for an IdP with a self-signed certificate, e.g. a local ThunderID
# FHIR_MCP_IDP_CA_CERT="<path to ThunderID>/server/config/certs/server.cert"
# (Optional) Defaults to <FHIR_MCP_SERVER_URL>/mcp; tokens must carry it as `aud`
FHIR_MCP_RESOURCE_URL="http://localhost:8000/mcp"
# (Optional) Defaults to the jwks_uri in the IdP's metadata
# FHIR_MCP_JWKS_URI=""
# Scopes required by the read, write and delete tools: the permissions of the MCP server's
# resource server at the IdP. Defaults: fhir-read, fhir-write, fhir-delete.
FHIR_MCP_READ_SCOPE="fhir_read"
FHIR_MCP_WRITE_SCOPE="fhir_write"
FHIR_MCP_DELETE_SCOPE="fhir_delete"

# =====================================================================
# FHIR server: where the data comes from
# The user an agent acts for links it once through a link the server sends: they choose the
# tools it may use, then sign in at the FHIR server with the app below. The agent's session
# (that user's FHIR tokens and allowed tools) is kept in memory: a restart forgets it, and the
# user links the agent again.
# =====================================================================
FHIR_SERVER_BASE_URL="https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4"
# The FHIR server's user-facing app (e.g. an Epic patient app), with redirect URI
# <server URL>/connect/fhir/callback. Leave the client ID empty for a FHIR server that needs no
# credential (then requests carry none), and the secret empty for a public app.
# Requires FHIR_MCP_AUTH_MODE=resource_server.
FHIR_SERVER_CLIENT_ID=""
FHIR_SERVER_CLIENT_SECRET=""
# Must include `openid fhirUser`; `offline_access` gets a refresh token, so users link less often.
FHIR_SERVER_SCOPES="openid fhirUser offline_access patient/Patient.read patient/Condition.read patient/Observation.read"
# (Optional) Default to the endpoints in <FHIR_SERVER_BASE_URL>/.well-known/smart-configuration
# FHIR_SERVER_AUTHORIZE_URL=""
# FHIR_SERVER_TOKEN_URL=""
# (Optional) Extra CA certificate for the FHIR server and its token endpoints, e.g. a gateway
# with a self-signed certificate. Added to the system trust store.
# FHIR_SERVER_CA_CERT=""

# =====================================================================
# Database for the Docker Compose stack (docker-compose.yml)
# =====================================================================
DB_USER="postgres"
DB_PASSWORD=''
DB_NAME="postgres"
