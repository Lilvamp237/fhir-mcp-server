# =====================================================================
# MCP server
# =====================================================================
FHIR_MCP_HOST="localhost"
FHIR_MCP_PORT="8000"
# (Optional) Public base URL of the server; defaults to http://<host>:<port>
# FHIR_MCP_SERVER_URL=""
# (Optional) Timeout for calls from the MCP server to the FHIR server, in seconds
# FHIR_MCP_REQUEST_TIMEOUT=30
# (Optional) Host and Origin values accepted when the server is reached by a name other than localhost
# FHIR_MCP_ALLOWED_HOSTS="mcp.example.com"
# FHIR_MCP_ALLOWED_ORIGINS="https://app.example.com"
# (Optional) Maximum request body size in bytes; the SDK default is 4 MiB
# FHIR_MCP_MAX_REQUEST_BODY_BYTES=4194304

# =====================================================================
# MCP login: who may use the MCP server
# Clients sign in with your identity provider (IdP); the server validates their tokens.
# =====================================================================
# "resource_server" (default), or "disabled" for local development without sign-in
# FHIR_MCP_AUTH_MODE="resource_server"
FHIR_MCP_IDP_ISSUER=""
# (Optional) Defaults to <FHIR_MCP_SERVER_URL>/mcp; tokens must carry it as `aud`
# FHIR_MCP_RESOURCE_URL="http://localhost:8000/mcp"
# (Optional) "jwks" (default) or "introspection"
# FHIR_MCP_TOKEN_VALIDATION="jwks"
# (Optional) jwks: defaults to the jwks_uri in the IdP's metadata
# FHIR_MCP_JWKS_URI=""
# introspection: the server's client at the IdP
# FHIR_MCP_INTROSPECTION_CLIENT_ID=""
# FHIR_MCP_INTROSPECTION_CLIENT_SECRET=""
# (Optional) Scopes required by the read, write and delete tools
# FHIR_MCP_READ_SCOPE="fhir-read"
# FHIR_MCP_WRITE_SCOPE="fhir-write"
# FHIR_MCP_DELETE_SCOPE="fhir-delete"
# (Optional) CA certificate for an IdP with a self-signed certificate, e.g. a local ThunderID
# FHIR_MCP_IDP_CA_CERT="./thunderid.cert"

# =====================================================================
# FHIR server: where the data comes from, and how the MCP server signs in to it
# =====================================================================
FHIR_SERVER_BASE_URL=""
# (Optional) How the MCP server authenticates to the FHIR server:
#   "none"               no credential
#   "static_token"       a fixed token (FHIR_SERVER_ACCESS_TOKEN)
#   "client_credentials" the server's own client ID and secret
#   "private_key_jwt"    the server's own signed assertion, e.g. SMART Backend Services for Epic
#   "user_smart_login"   each user signs in to the FHIR server, e.g. SMART App Launch for Epic
# Defaults to "static_token" when FHIR_SERVER_ACCESS_TOKEN is set, otherwise "none".
# FHIR_SERVER_AUTH_MODE="none"

# --- static_token ---
# FHIR_SERVER_ACCESS_TOKEN=""

# --- client_credentials and private_key_jwt ---
# FHIR_SERVER_CLIENT_ID=""
# FHIR_SERVER_CLIENT_SECRET=""                      # client_credentials
# FHIR_SERVER_PRIVATE_KEY_FILE="./backend-key.pem"  # private_key_jwt
# FHIR_SERVER_PRIVATE_KEY_ID=""                     # `kid` of the key in your registered JWKS
# FHIR_SERVER_JWT_ALGORITHM="RS384"
# FHIR_SERVER_SCOPES="system/Patient.read system/Observation.read"
# (Optional) Defaults to the token_endpoint in <FHIR_SERVER_BASE_URL>/.well-known/smart-configuration
# FHIR_SERVER_TOKEN_URL=""
# (Optional) RFC 8707 resource for the system token, e.g. for a gateway that trusts your IdP
# FHIR_SERVER_TOKEN_RESOURCE=""

# --- user_smart_login ---
# Users connect their own FHIR server account through a link the server sends.
# FHIR_SERVER_CLIENT_ID / FHIR_SERVER_CLIENT_SECRET are the FHIR server's user-facing app
# (redirect URI: <server URL>/connect/fhir/callback). With FHIR_SERVER_PRIVATE_KEY_FILE set,
# the app signs in with its key pair instead of the secret.
# FHIR_SERVER_SCOPES="openid fhirUser user/Patient.read"
# (Optional) Default to the endpoints in <FHIR_SERVER_BASE_URL>/.well-known/smart-configuration
# FHIR_SERVER_AUTHORIZE_URL=""
# FHIR_SERVER_TOKEN_URL=""
# A web client at your IdP that confirms who opens the link (redirect URI: <server URL>/connect/idp/callback)
# FHIR_MCP_CONNECT_CLIENT_ID=""
# FHIR_MCP_CONNECT_CLIENT_SECRET=""

# (Optional) Extra CA certificate for the FHIR server and its token endpoints, e.g. a local IdP or
# gateway with a self-signed certificate. Added to the system trust store.
# FHIR_SERVER_CA_CERT="./thunderid.cert"

# =====================================================================
# Access policy: which records each signed-in user may see
# Role from the token's fhirUser claim: Patient/... own records; RelatedPerson/... and Person/...
# their patients' records; Practitioner/... and PractitionerRole/... every patient; others nothing.
# All optional; the defaults need no configuration.
# =====================================================================
# "deny" (default), or "own" to let patients create and change their own records
# FHIR_POLICY_PATIENT_WRITES="deny"
# Allow RelatedPerson and Person users (default true)
# FHIR_POLICY_CAREGIVERS=true
# Types any signed-in user may read
# FHIR_POLICY_SHARED_TYPES="Practitioner PractitionerRole Organization Location Medication"
# Refuse create, update and delete for everyone, e.g. an open server used by a single agent
# FHIR_MCP_READ_ONLY=false

# =====================================================================
# Database for the Docker Compose stack (docker-compose.yml)
# =====================================================================
DB_USER="postgres"
DB_PASSWORD=''
DB_NAME="postgres"
